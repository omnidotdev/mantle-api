{
  "name": "@omnidotdev/mantle-api",
  "version": "0.2.0",
  "private": true,
  "license": "Apache-2.0",
  "main": "build/server.js",
  "module": "build/server.js",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "release": "changeset publish",
    "dev": "NODE_ENV=development GRAPHILE_ENV=development bun run --watch src/server.ts",
    "build": "bun build --target node --outdir build src/server.ts src/instrumentation.ts",
    "start": "NODE_ENV=production GRAPHILE_ENV=production bun run src/scripts/db/migrate.ts && NODE_ENV=production GRAPHILE_ENV=production bun run --import ./build/instrumentation.js build/server.js",
    "start:source": "NODE_ENV=production GRAPHILE_ENV=production bun run src/scripts/db/migrate.ts && NODE_ENV=production GRAPHILE_ENV=production bun --preload ./src/instrumentation.ts src/server.ts",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check",
    "knip": "knip-bun",
    "db:setup": "bun src/scripts/db/setupDatabase.ts",
    "db:check": "bun --env-file .env.local --bun drizzle-kit check --config src/lib/config/drizzle.config.ts",
    "db:generate": "bun --env-file .env.local --bun drizzle-kit generate --config src/lib/config/drizzle.config.ts",
    "db:migrate": "bun --env-file .env.local --bun drizzle-kit migrate --config src/lib/config/drizzle.config.ts && GRAPHILE_ENV=development bun graphql:generate",
    "db:migrate:drop": "bun --env-file .env.local --bun drizzle-kit drop --config src/lib/config/drizzle.config.ts",
    "db:pull": "bun --env-file .env.local --bun drizzle-kit introspect --config src/lib/config/drizzle.config.ts",
    "db:push": "bun --env-file .env.local --bun drizzle-kit push --config src/lib/config/drizzle.config.ts",
    "db:studio": "bun --env-file .env.local --bun drizzle-kit studio --config src/lib/config/drizzle.config.ts",
    "db:up": "bun --env-file .env.local --bun drizzle-kit up --config src/lib/config/drizzle.config.ts",
    "graphql:generate": "GRAPHILE_ENV=development bun run --env-file .env.local src/scripts/generateGraphqlSchema.ts",
    "channel:connect": "bun --env-file .env.local src/scripts/channel-connect.ts",
    "sync:channels": "bun --env-file .env.local src/scripts/sync-channels.ts",
    "import:catalog": "bun --env-file .env.local src/scripts/import-catalog.ts",
    "import:etsy": "bun --env-file .env.local src/scripts/import-etsy.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.3",
    "@elysiajs/graphql-yoga": "^1.4.1",
    "@envelop/generic-auth": "^11.2.3",
    "@envelop/opentelemetry": "^9.2.2",
    "@envelop/parser-cache": "^10.2.1",
    "@envelop/validation-cache": "^10.2.1",
    "@escape.tech/graphql-armor": "^3.2.0",
    "@graphile/pg-aggregates": "^0.2.0-rc.2",
    "@graphile/simplify-inflection": "^9.0.1",
    "@graphql-yoga/plugin-disable-introspection": "^2.25.6",
    "@omnidotdev/providers": "github:omnidotdev/providers#v0.4.1",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.83.1",
    "@opentelemetry/exporter-logs-otlp-http": "^0.301.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-logs": "^3.1.1",
    "@opentelemetry/sdk-node": "^0.301.2",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "@tanstack/query-core": "^5.108.4",
    "drizzle-orm": "^0.45.4",
    "elysia": "^1.4.32",
    "grafast": "^1.2.1",
    "graphile-export": "^1.0.3",
    "graphql": "^16.15.0",
    "graphql-yoga": "^5.24.6",
    "jose": "^6.2.18",
    "ms": "^2.1.3",
    "pg": "^8.23.1",
    "postgraphile": "^5.2.1",
    "postgraphile-plugin-connection-filter": "^4.0.1",
    "unleash-client": "^6.12.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@envelop/types": "^5.2.2",
    "@types/bun": "^1.4.5",
    "@types/ms": "^2.1.0",
    "drizzle-kit": "^0.31.11",
    "drizzle-seed": "^0.3.1",
    "husky": "^9.1.7",
    "knip": "^6.48.0",
    "msw": "^2.15.0",
    "typescript": "^7.0.2"
  },
  "trustedDependencies": [
    "@biomejs/biome"
  ]
}
