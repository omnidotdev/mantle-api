# Copy this file to .env.local and fill in the values

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mantle

# Auth (JWKS endpoint for token verification)
AUTH_JWKS_URL=https://localhost:3100/.well-known/jwks.json
# Userinfo, for the caller's workspace roles (access tokens list workspace ids
# only). Optional: defaults to /oauth2/userinfo on the JWKS host
AUTH_USERINFO_URL=

# Self-host with an OpenID Connect provider other than Omni Gatekeeper: give a
# caller whose token has no workspace claims a personal workspace (mantle-app
# needs the same setting)
# PERSONAL_WORKSPACE_FALLBACK=true

# Workspace deletion (Gatekeeper organization.deleted delivered by Vortex to
# POST /webhooks/idp); unset refuses every call
IDP_WEBHOOK_SECRET=

# Billing (Aether), optional. Unset: no plan limits apply (self-hosting).
# Set: plan limits (contacts, invoices per month) are read from Aether and
# enforced on creates; an outage keeps the last known plan, else blocks nothing
BILLING_BASE_URL=
BILLING_SERVICE_API_KEY=
# Comma-separated organization IDs exempt from plan limits
BILLING_BYPASS_ORG_IDS=

# Authorization (Warden), optional. Unset: the JWT workspace claims are the only
# gate. Set: owner/admin checks are also confirmed with Warden (denials are only
# logged until WARDEN_ENFORCE=true; an unreachable Warden falls back to the JWT)
AUTHZ_API_URL=
AUTHZ_SERVICE_KEY=
WARDEN_ENFORCE=

# Feature flags
UNLEASH_SERVER_API_URL=
UNLEASH_SERVER_API_TOKEN=

# Etsy (for import-etsy script)
ETSY_API_KEY=
